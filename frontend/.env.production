# Production build (vite build --mode production) — values baked into the
# bundle at build time. Nothing here is a secret; R2 keys stay on the Worker.
#
# Laravel API on Fly.io. NOTE: includes the /api suffix.
VITE_API_BASE=https://famvault-backend.fly.dev/api

# Public Cloudflare Worker in front of the R2 bucket. Only used when
# VITE_USE_WORKER_FILES=true (see src/api.js); default is the Laravel proxy.
VITE_R2_WORKER=https://famvault-r2.famvault.workers.dev
