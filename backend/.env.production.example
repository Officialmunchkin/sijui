# =============================================================================
# FAM VAULT API — production environment template
# -----------------------------------------------------------------------------
# Copy the values you need into your host's "Environment Variables" panel
# (Render / Railway / Fly). Do NOT commit a real .env file.
#
#   Render:  Dashboard -> your service -> Environment
#   Railway: your service -> Variables
# =============================================================================

APP_NAME="FAM VAULT"
APP_ENV=production
APP_DEBUG=false
# Generate once locally:  php artisan key:generate --show
# Keep it stable forever — it encrypts the saved member passwords.
APP_KEY=
# Public URL of THIS api (used for logs/links), e.g. https://famvault-api.onrender.com
APP_URL=

# ----------------------------------------------------------------- database
# Option A — managed Postgres (recommended; survives redeploys):
DB_CONNECTION=pgsql
DB_URL=                      # paste the database's connection string / DATABASE_URL
# Option B — SQLite on a mounted volume (see DEPLOY.md):
# DB_CONNECTION=sqlite
# DB_DATABASE=/data/database.sqlite

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack
LOG_LEVEL=warning

# ------------------------------------------------- Cloudflare Worker / R2
# No R2 keys live here — the Worker holds them server-side.
WORKER_API_URL=https://famvault-r2.famvault.workers.dev
WORKER_ROLE_HEADER=X-Famvault-Role
WORKER_MEMBER_ROLE=member
WORKER_TIMEOUT=15
R2_BUCKET_NAME=familyvault
WORKER_CA_BUNDLE=            # leave empty on Linux hosts

# ------------------------------------------------------------------- family
FAMVAULT_ADMIN_ID=herman
FAMVAULT_SESSION_DAYS=30

# -------------------------------------------------------- frontend + CORS
# Your Netlify site (no trailing slash). CORS must list it exactly.
FRONTEND_URL=https://YOUR-SITE.netlify.app
CORS_ALLOWED_ORIGINS=https://YOUR-SITE.netlify.app
