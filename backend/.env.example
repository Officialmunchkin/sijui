APP_NAME="FAM VAULT"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Path used inside the Fly container (the volume is mounted at storage/).
# Leave unset locally to use the default backend/database/database.sqlite.
DB_DATABASE=/var/www/html/storage/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

# ---------------------------------------------------------------------
# Cloudflare R2 (via the famvault-r2 Worker)
# ---------------------------------------------------------------------
# Photos/videos live in the R2 bucket "familyvault". All access goes through
# the public Worker endpoint below — NO R2 credentials (access keys, secret,
# account id, token) are stored in this codebase. The Worker keeps the R2
# keys server-side. The frontend never talks to the Worker or R2 directly;
# it only talks to this Laravel API, which proxies file bytes through the
# Worker (see App\Services\WorkerClient).
WORKER_API_URL=https://famvault-r2.famvault.workers.dev
WORKER_ROLE_HEADER=X-Famvault-Role
WORKER_MEMBER_ROLE=member
WORKER_TIMEOUT=15
R2_BUCKET_NAME=familyvault

# Optional: path to a CA bundle (relative to project root) if Windows PHP
# fails SSL verification against the Worker. Leave blank on Linux/macOS.
WORKER_CA_BUNDLE=

# The single member id that is seeded as admin.
FAMVAULT_ADMIN_ID=herman
FAMVAULT_SESSION_DAYS=30

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173