# Keep the image lean and secret-free.
vendor
node_modules
.git
.gitignore

# Never bake local secrets into the image.
.env
.env.*
!.env.example

# Local state — the SQLite DB lives on the Fly volume, not in the image.
storage/database.sqlite
storage/*.sqlite
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php
